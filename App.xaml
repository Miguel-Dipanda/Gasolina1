<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gasolina.App">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Couleurs -->
            <Color x:Key="PrimaryBlue">#23406E</Color>
            <Color x:Key="BackgroundLight">#F3F4F6</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>

            <!-- Styles globaux -->
            <Style TargetType="Border" x:Key="CardStyle">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Shadow">
                    <Shadow Brush="#10000000" Offset="0,4" Radius="8" Opacity="0.1" />
                </Setter>
            </Style>

            <Style TargetType="Button" x:Key="PrimaryBtnStyle">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlue}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>