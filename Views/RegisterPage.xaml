<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gasolina.Views.RegisterPage"
             BackgroundColor="{StaticResource BackgroundLight}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="140, *">
        <!-- Header Bleu -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource PrimaryBlue}">
            <Label Text="GASOLINA" TextColor="White" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <!-- Carte Blanche avec le Formulaire -->
        <Border Grid.Row="1" Margin="20,-30,20,20" Style="{StaticResource CardStyle}">
            <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                <Label Text="Créer un compte" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                <!-- Champ 1 : Nom complet -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Nom complet" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                    <Border Style="{StaticResource CardStyle}" Padding="0,0,10,0">
                        <Entry Placeholder="Ex: Luc Miguel" />
                    </Border>
                </VerticalStackLayout>

                <!-- Champ 2 : Adresse e-mail -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Adresse e-mail" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                    <Border Style="{StaticResource CardStyle}" Padding="0,0,10,0">
                        <Entry Placeholder="exemple@email.com" Keyboard="Email" />
                    </Border>
                </VerticalStackLayout>

                <!-- Champ 3 : Mot de passe -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Mot de passe" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                    <Border Style="{StaticResource CardStyle}" Padding="0,0,10,0">
                        <Entry IsPassword="True" Placeholder="••••••••" />
                    </Border>
                </VerticalStackLayout>

                <!-- Champ 4 : Confirmer le mot de passe -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Confirmer le mot de passe" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                    <Border Style="{StaticResource CardStyle}" Padding="0,0,10,0">
                        <Entry IsPassword="True" Placeholder="••••••••" />
                    </Border>
                </VerticalStackLayout>

                <!-- Bouton d'inscription -->
                <Button Text="S'inscrire" Style="{StaticResource PrimaryBtnStyle}" Margin="0,10,0,0" Clicked="OnRegisterClicked" />

                <!-- Lien pour revenir à la connexion -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
                    <Label Text="Déjà un compte ?" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                    <Label Text="Se connecter" TextColor="{StaticResource PrimaryBlue}" FontAttributes="Bold" FontSize="12">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>