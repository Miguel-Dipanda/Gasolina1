<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Gasolina.Views.HistoryPage"
             BackgroundColor="{StaticResource BackgroundLight}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="120, *">
        <!-- Header Bleu -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource PrimaryBlue}" Padding="20">
            <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                <Label Text="Historique" TextColor="White" FontSize="24" FontAttributes="Bold" />
                <Label Text="Vos derniers relevés" TextColor="#D1D5DB" FontSize="14" />
            </VerticalStackLayout>
        </Grid>

        <!-- Contenu principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20">

                <!-- Relevé 1 -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="08 OCT. 2026" TextColor="{StaticResource TextSecondary}" FontSize="12" FontAttributes="Bold" />
                        <Label Text="42,5 L • 28 475 FCFA" TextColor="{StaticResource PrimaryBlue}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="12 480 km • Essence" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- Relevé 2 -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="28 SEPT. 2026" TextColor="{StaticResource TextSecondary}" FontSize="12" FontAttributes="Bold" />
                        <Label Text="38,2 L • 25 594 FCFA" TextColor="{StaticResource PrimaryBlue}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="12 050 km • Essence" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- Relevé 3 -->
                <Border Style="{StaticResource CardStyle}" Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="12 SEPT. 2026" TextColor="{StaticResource TextSecondary}" FontSize="12" FontAttributes="Bold" />
                        <Label Text="40,0 L • 26 800 FCFA" TextColor="{StaticResource PrimaryBlue}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="11 620 km • Essence" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- Section État vide (Exemple d'affichage si aucun relevé) -->
                <Label Text="État vide — si aucun relevé" TextColor="{StaticResource TextPrimary}" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />

                <Border Style="{StaticResource CardStyle}" Padding="30">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Aucun historique disponible" TextColor="{StaticResource TextSecondary}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Vos pleins apparaîtront ici." TextColor="{StaticResource TextSecondary}" FontSize="13" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Bouton de retour au Tableau de bord -->
                <Button Text="Annuler" 
                        BackgroundColor="Transparent" 
                        TextColor="{StaticResource TextSecondary}" 
                        BorderColor="{StaticResource TextSecondary}" 
                        BorderWidth="1" 
                        CornerRadius="8" 
                        HeightRequest="50" 
                        Margin="0,15,0,20" 
                        Clicked="OnBackClicked" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>